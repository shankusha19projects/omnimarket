# OmniMarket Intelligence Terminal — environment configuration
# Copy to .env (or use Settings → Data Providers in the app, which writes this file for you).
# Secrets stay server-side: the browser only ever learns whether a key is configured.
# Everything works WITHOUT keys using keyless public sources (Yahoo-compatible, SEC EDGAR,
# U.S. Treasury, BLS, CoinGecko, NY Fed / ECB / BoE / BoC, Nasdaq calendars, publisher RSS).

# --- Economic data (free, strongly recommended: unlocks GDP, PCE, housing, credit spreads, claims…)
FRED_API_KEY=

# --- Optional market data providers (fallbacks in the quote chain)
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=
POLYGON_API_KEY=
COINMARKETCAP_API_KEY=
NEWS_API_KEY=

# --- Web research agent (free Search & Fetch: https://agent.tinyfish.ai/api-keys)
TINYFISH_API_KEY=

# --- AI advisor
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# auto | anthropic | openai | ollama | none
AI_PROVIDER=auto
# blank = provider default (Anthropic: claude-opus-5)
AI_MODEL=
OLLAMA_BASE_URL=http://localhost:11434

# --- SEC fair-access identity (please put your name and email)
SEC_USER_AGENT=OmniMarket Research Terminal (local research use) admin@localhost

# --- Server (binds to localhost only by default)
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
